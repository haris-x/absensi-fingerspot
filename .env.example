# ===========================
# Database MySQL (Fingerspot)
# ===========================
DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=fin_pro

# ===========================
# WhatsApp Bot
# ===========================
WA_GROUP_JID=
WA_SEND_TIME=07:35
WA_RECONCILIATION_ENABLED=false
